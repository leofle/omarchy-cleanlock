#!/usr/bin/env python3
"""Watch for the unlock chord held for 5 seconds, then unlock.

Reads /dev/input directly so it still works after Hyprland disables the keyboard.
Progress is reported as whole seconds 1..5 (not a percentage).

Unlock chords:
  - Classic: Left Super + Right Super held together for 5s
  - Copilot keyboards (no Right Super): hold Left Super, tap Copilot once
    while Left Super is down, then keep holding Left Super for 5s.

The Copilot key is usually hard-wired as Meta+Shift+F23 and often pulses
(down then immediate up), so F23 is latched while Left Super stays held.
"""

from __future__ import annotations

import array
import fcntl
import glob
import os
import select
import struct
import time

EV_KEY = 0x01
KEY_LEFTMETA = 125
KEY_RIGHTMETA = 126
KEY_F23 = 193
KEY_ASSISTANT = 0x247  # 583 — some stacks remap Copilot here
EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
HOLD_SECONDS = 5

# EVIOCGBIT(EV_KEY, 64) — 512 key bits (covers F23; ASSISTANT needs a larger buffer)
def _eviocgbit_key(length: int = 128) -> int:
    nr = 0x20 + EV_KEY
    return (2 << 30) | (ord("E") << 8) | nr | (length << 16)


STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy",
    "cleanlock",
)
PROGRESS_FILE = os.path.join(STATE_DIR, "chord-progress")
STATE_FILE = os.path.join(STATE_DIR, "locked.json")


def write_progress_seconds(seconds: int) -> None:
    """Persist 0..5 for the panel / status JSON."""
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = PROGRESS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(str(max(0, min(HOLD_SECONDS, int(seconds)))))
    os.replace(tmp, PROGRESS_FILE)


def clear_progress() -> None:
    try:
        os.remove(PROGRESS_FILE)
    except FileNotFoundError:
        pass


def still_locked() -> bool:
    try:
        import json

        with open(STATE_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
        return bool(data.get("keyboard") or data.get("trackpad"))
    except (FileNotFoundError, ValueError, TypeError):
        return False


def device_has_unlock_keys(fd: int) -> bool:
    """Prefer keyboards that report Left Meta (with or without Right Meta / F23)."""
    buf = array.array("B", [0] * 128)
    try:
        fcntl.ioctl(fd, _eviocgbit_key(len(buf)), buf)
    except OSError:
        return False

    def has(code: int) -> bool:
        if code // 8 >= len(buf):
            return False
        return bool(buf[code // 8] & (1 << (code % 8)))

    if not has(KEY_LEFTMETA):
        return False
    # Classic dual-Super, Copilot (F23), or Left-Meta-only boards (fallback path).
    return True


def open_keyboards() -> list[tuple[int, str]]:
    fds: list[tuple[int, str]] = []
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        if device_has_unlock_keys(fd):
            fds.append((fd, path))
        else:
            os.close(fd)
    # Fallback: if capability probe fails everywhere, watch all readable nodes.
    if not fds:
        for path in sorted(glob.glob("/dev/input/event*")):
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            fds.append((fd, path))
    return fds


def unlock() -> None:
    plugin_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cleanlock")
    os.spawnl(os.P_WAIT, plugin_bin, plugin_bin, "unlock")


def is_copilot_code(code: int) -> bool:
    return code in (KEY_F23, KEY_ASSISTANT)


def main() -> int:
    os.makedirs(STATE_DIR, exist_ok=True)
    clear_progress()
    fds = open_keyboards()
    if not fds:
        return 1

    left = False
    right = False
    # Copilot pulses Meta+Shift+F23 (often with an immediate Meta release).
    # Latch F23/Assistant while Left Super stays down, and briefly ignore the
    # synthetic Left Meta up so a held Win key is not cleared by the pulse.
    copilot_latched = False
    suppress_left_release_until = 0.0
    hold_started: float | None = None
    last_second_shown = 0

    try:
        while still_locked():
            readable, _, _ = select.select([fd for fd, _ in fds], [], [], 0.05)
            now = time.monotonic()

            for fd in readable:
                while True:
                    try:
                        data = os.read(fd, EVENT_SIZE * 8)
                    except BlockingIOError:
                        break
                    if not data:
                        break
                    # Process complete events only; keep alignment.
                    offset = 0
                    while offset + EVENT_SIZE <= len(data):
                        chunk = data[offset : offset + EVENT_SIZE]
                        offset += EVENT_SIZE
                        _sec, _usec, etype, code, value = struct.unpack(EVENT_FMT, chunk)
                        if etype != EV_KEY:
                            continue
                        # value: 0 release, 1 press, 2 repeat — treat repeat as still down
                        if code == KEY_LEFTMETA:
                            if value != 0:
                                left = True
                            elif now < suppress_left_release_until:
                                # Synthetic release from Copilot chord — keep left.
                                pass
                            else:
                                left = False
                                copilot_latched = False
                        elif code == KEY_RIGHTMETA:
                            right = value != 0
                        elif is_copilot_code(code) and value == 1:
                            # Arm only while Left Super is already held (avoids
                            # "tap Copilot earlier, then hold Win" accidents).
                            if left:
                                copilot_latched = True
                                suppress_left_release_until = now + 0.3

            chord_active = left and (right or copilot_latched)

            if chord_active:
                if hold_started is None:
                    hold_started = now
                    last_second_shown = 0
                    write_progress_seconds(0)

                elapsed = now - hold_started
                # Completed whole seconds: 1 after 1s, …, 5 after 5s.
                # Showing "5" one second early made unlock feel like a 6-count.
                second = min(HOLD_SECONDS, int(elapsed))

                if second != last_second_shown and second > 0:
                    write_progress_seconds(second)
                    last_second_shown = second

                if elapsed >= HOLD_SECONDS:
                    write_progress_seconds(HOLD_SECONDS)
                    unlock()
                    return 0
            else:
                if hold_started is not None:
                    hold_started = None
                    last_second_shown = 0
                    clear_progress()
    finally:
        clear_progress()
        for fd, _ in fds:
            try:
                os.close(fd)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
