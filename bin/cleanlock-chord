#!/usr/bin/env python3
"""Unlock after either Super key is continuously down for five seconds.

Query the kernel's current key bitmap instead of remembering key events. This
avoids stuck holds after Copilot pulses, missed releases, or device removal.
"""
from __future__ import annotations
import array
import fcntl
import glob
import json
import os
import subprocess
import sys
import time

KEY_LEFTMETA = 125
KEY_RIGHTMETA = 126
HOLD_SECONDS = 5
STATE_DIR = os.path.join(os.environ.get('XDG_STATE_HOME', os.path.expanduser('~/.local/state')), 'omarchy', 'cleanlock')
STATE_FILE = os.path.join(STATE_DIR, 'locked.json')
PROGRESS_FILE = os.path.join(STATE_DIR, 'chord-progress')
READY_FILE = os.path.join(STATE_DIR, 'chord-ready')


def bitmap(fd, nr):
    buf = array.array('B', [0] * 128)
    fcntl.ioctl(fd, (2 << 30) | (len(buf) << 16) | (ord('E') << 8) | nr, buf)
    return buf


def has(buf, code):
    return bool(buf[code // 8] & (1 << (code % 8)))


def open_keyboards():
    devices = []
    for path in sorted(glob.glob('/dev/input/event*')):
        fd = None
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            keys = bitmap(fd, 0x21)  # EVIOCGBIT(EV_KEY)
            if has(keys, KEY_LEFTMETA) or has(keys, KEY_RIGHTMETA):
                bitmap(fd, 0x18)  # Verify EVIOCGKEY access before locking.
                devices.append((fd, path))
                fd = None
        except OSError:
            pass
        finally:
            if fd is not None:
                os.close(fd)
    return devices


def still_locked():
    try:
        with open(STATE_FILE) as fh:
            state = json.load(fh)
        return bool(state.get('keyboard') or state.get('trackpad'))
    except (OSError, ValueError, AttributeError):
        return False


def remove(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def progress(seconds):
    tmp = PROGRESS_FILE + '.tmp'
    with open(tmp, 'w') as fh:
        fh.write(str(seconds))
    os.replace(tmp, PROGRESS_FILE)


def unlock():
    env = dict(os.environ, CLEANLOCK_FROM_CHORD='1')
    subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), 'cleanlock'), 'unlock'], env=env, check=True)


class Hold:
    def __init__(self):
        self.started = {}

    def update(self, pressed, now):
        # Each physical key must remain down; switching keys does not extend it.
        self.started = {key: self.started.get(key, now) for key in pressed}
        return min(HOLD_SECONDS, int(max((now - t for t in self.started.values()), default=0)))


def main():
    devices = open_keyboards()
    if not devices:
        print('Clean Lock cannot monitor Super: no readable keyboard input device. Run cleanlock setup-input first.', file=sys.stderr, flush=True)
        return 1
    try:
        if '--check' in sys.argv:
            print('Readable Super keyboard: ' + ', '.join(path for _, path in devices))
            return 0
        os.makedirs(STATE_DIR, exist_ok=True)
        remove(PROGRESS_FILE)
        with open(READY_FILE, 'w') as fh:
            fh.write(str(os.getpid()))
        hold = Hold()
        last = None
        while still_locked():
            pressed = set()
            for fd, path in devices:
                keys = bitmap(fd, 0x18)
                for code in (KEY_LEFTMETA, KEY_RIGHTMETA):
                    if has(keys, code):
                        pressed.add((path, code))
            second = hold.update(pressed, time.monotonic())
            if second != last:
                progress(second)
                last = second
            if second >= HOLD_SECONDS:
                unlock()
                return 0
            time.sleep(0.05)
        return 0
    except Exception as exc:
        print(f'Clean Lock monitor failed: {exc}; restoring inputs', file=sys.stderr, flush=True)
        if still_locked():
            unlock()
        return 1
    finally:
        for fd, _ in devices:
            os.close(fd)
        if '--check' not in sys.argv:
            remove(PROGRESS_FILE)
            remove(READY_FILE)


if __name__ == '__main__':
    raise SystemExit(main())
