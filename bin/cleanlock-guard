#!/usr/bin/env python3
"""Keep the session awake while Clean Lock is active, and force-unlock inputs
if the screen locks or the machine is about to sleep/hibernate.

Why: with the keyboard disabled in Hyprland, wiping keys does not count as
user activity, so idle can still lock the session — then the password
prompt has no working keyboard.
"""

from __future__ import annotations

import os
import signal
import subprocess
import sys
import time

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy",
    "cleanlock",
)
STATE_FILE = os.path.join(STATE_DIR, "locked.json")
STAY_AWAKE_FLAG = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy",
    "indicators",
    "stay-awake",
)
STAY_AWAKE_OWNED = os.path.join(STATE_DIR, "stay-awake-owned")
PLUGIN_BIN = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cleanlock")

running = True


def still_locked() -> bool:
    try:
        import json

        with open(STATE_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
        return bool(data.get("keyboard") or data.get("trackpad"))
    except (FileNotFoundError, ValueError, TypeError):
        return False


def session_locked() -> bool:
    try:
        out = subprocess.check_output(
            ["omarchy-shell", "lock", "isLocked"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=2,
        ).strip()
        return out == "true"
    except Exception:
        return False


def unlock_silent(reason: str) -> None:
    env = os.environ.copy()
    env["CLEANLOCK_SILENT"] = "1"
    env["CLEANLOCK_FROM_GUARD"] = "1"
    env["CLEANLOCK_UNLOCK_REASON"] = reason
    subprocess.call([PLUGIN_BIN, "unlock"], env=env)


def ensure_stay_awake() -> None:
    os.makedirs(STATE_DIR, exist_ok=True)
    already = os.path.exists(STAY_AWAKE_FLAG)
    if already:
        # User already wanted stay-awake; don't reclaim it on unlock.
        if os.path.exists(STAY_AWAKE_OWNED):
            os.remove(STAY_AWAKE_OWNED)
        return
    subprocess.call(
        ["omarchy-toggle-idle", "stay-awake"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    with open(STAY_AWAKE_OWNED, "w", encoding="utf-8") as fh:
        fh.write("1\n")


def release_stay_awake_if_owned() -> None:
    if not os.path.exists(STAY_AWAKE_OWNED):
        return
    try:
        os.remove(STAY_AWAKE_OWNED)
    except FileNotFoundError:
        pass
    subprocess.call(
        ["omarchy-toggle-idle", "allow-idle"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def handle_signal(signum, frame) -> None:  # noqa: ARG001
    global running
    running = False


def main() -> int:
    global running
    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    if not still_locked():
        return 0

    ensure_stay_awake()

    # Block idle + sleep while cleaning. Accidental key-noise / no Hyprland
    # activity must not lock or hibernate underneath us.
    inhibit = subprocess.Popen(
        [
            "systemd-inhibit",
            "--what=idle:sleep",
            "--who=Clean Lock",
            "--why=Keyboard/trackpad cleaning in progress",
            "--mode=block",
            "sleep",
            "infinity",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    # Watch login1 PrepareForSleep so we unlock before suspend/hibernate.
    dbus = subprocess.Popen(
        [
            "dbus-monitor",
            "--system",
            "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    try:
        while running and still_locked():
            # Safety: if the lock screen is up, restore input immediately.
            if session_locked():
                unlock_silent("session-locked")
                break

            # Drain dbus-monitor output for PrepareForSleep true
            if dbus.stdout is not None:
                while True:
                    # Non-blocking-ish: use select with short timeout via poll of pipe
                    import select

                    ready, _, _ = select.select([dbus.stdout], [], [], 0)
                    if not ready:
                        break
                    line = dbus.stdout.readline()
                    if not line:
                        break
                    if "boolean true" in line:
                        unlock_silent("prepare-for-sleep")
                        running = False
                        break

            time.sleep(0.4)
    finally:
        if inhibit.poll() is None:
            inhibit.terminate()
            try:
                inhibit.wait(timeout=2)
            except subprocess.TimeoutExpired:
                inhibit.kill()
        if dbus.poll() is None:
            dbus.terminate()
            try:
                dbus.wait(timeout=2)
            except subprocess.TimeoutExpired:
                dbus.kill()
        # Only release stay-awake if we still own it and cleanlock is gone.
        if not still_locked():
            release_stay_awake_if_owned()
    return 0


if __name__ == "__main__":
    sys.exit(main())
