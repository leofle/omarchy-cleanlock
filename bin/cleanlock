#!/bin/bash
# Backend for Clean Lock — disable keyboard and/or trackpad for cleaning.
set -Eeuo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/cleanlock"
STATE_FILE="$STATE_DIR/locked.json"
CHORD_PID_FILE="$STATE_DIR/chord.pid"
GUARD_PID_FILE="$STATE_DIR/guard.pid"
PROGRESS_FILE="$STATE_DIR/chord-progress"
STAY_AWAKE_OWNED="$STATE_DIR/stay-awake-owned"
PLUGIN_ID="io.github.leofle.cleanlock"

# Resolve through ~/.local/bin symlinks; fall back to the known plugin path.
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_BIN_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PLUGIN_DIR="$(cd -- "$SCRIPT_BIN_DIR/.." && pwd)"
if [[ ! -x $PLUGIN_DIR/bin/cleanlock-chord ]]; then
  if [[ -x $SCRIPT_BIN_DIR/cleanlock-chord ]]; then
    PLUGIN_DIR="$(cd -- "$SCRIPT_BIN_DIR/.." && pwd)"
  elif [[ -x $HOME/.config/omarchy/plugins/$PLUGIN_ID/bin/cleanlock-chord ]]; then
    PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
  fi
fi
CHORD_BIN="$PLUGIN_DIR/bin/cleanlock-chord"
GUARD_BIN="$PLUGIN_DIR/bin/cleanlock-guard"
SILENT=${CLEANLOCK_SILENT:-0}

mkdir -p "$STATE_DIR"

usage() {
  cat >&2 <<'EOF'
Usage: cleanlock <lock-keyboard|lock-trackpad|lock-both|unlock|status|diagnose|chord-start|chord-stop|guard-start|guard-stop>
EOF
}

quote_lua() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

set_enabled() {
  local name=$1 enabled=$2
  local quoted
  quoted=$(quote_lua "$name")
  hyprctl eval "hl.device({ name = \"$quoted\", enabled = $enabled })" >/dev/null
}

list_keyboards() {
  hyprctl devices -j | jq -r '
    .keyboards[]?.name
    | select(
        . != null and . != ""
        and (startswith("hl-virtual-keyboard") | not)
        and (contains("lid") | not)
        and (contains("power") | not)
        and (contains("Consumer") | not)
        and (contains("System") | not)
      )
  '
}

list_trackpads() {
  if command -v omarchy-hw-touchpad >/dev/null 2>&1; then
    local name
    name=$(omarchy-hw-touchpad 2>/dev/null || true)
    if [[ -n ${name:-} ]]; then
      printf '%s\n' "$name"
      return 0
    fi
  fi
  hyprctl devices -j | jq -r '
    .mice[]?.name
    | select(. != null and . != "" and (test("trackpad|touchpad|Touchpad|Trackpad"; "i")))
  '
}

write_state() {
  local kb_json=$1 tp_json=$2
  printf '{"keyboard":%s,"trackpad":%s}\n' "$kb_json" "$tp_json" >"$STATE_FILE"
}

read_state() {
  if [[ -f $STATE_FILE ]]; then
    cat "$STATE_FILE"
  else
    echo '{"keyboard":[],"trackpad":[]}'
  fi
}

kill_pidfile() {
  local file=$1
  if [[ -f $file ]]; then
    local pid
    pid=$(cat "$file" 2>/dev/null || true)
    local helper="$CHORD_BIN"
    [[ $file == "$GUARD_PID_FILE" ]] && helper="$GUARD_BIN"
    # PID files can survive a reboot; never signal an unrelated process.
    if [[ ${pid:-} =~ ^[0-9]+$ ]] && [[ -r /proc/$pid/cmdline ]] &&
      tr '\0' '\n' <"/proc/$pid/cmdline" | grep -Fxq -- "$helper"; then
      kill "$pid" 2>/dev/null || true
      # May not be our child; never fail the lock/unlock under set -e.
      wait "$pid" 2>/dev/null || true
    fi
    rm -f "$file"
  fi
  return 0
}

chord_stop() {
  kill_pidfile "$CHORD_PID_FILE"
  rm -f "$PROGRESS_FILE" "$STATE_DIR/chord-ready"
  return 0
}

chord_start() {
  chord_stop
  if [[ ! -f $CHORD_BIN ]]; then
    echo "cleanlock: missing chord helper at $CHORD_BIN" >>"$STATE_DIR/chord.log"
    echo "cleanlock: missing chord helper at $CHORD_BIN" >&2
    return 1
  fi
  {
    echo "---- chord-start $(date -Iseconds) plugin=$PLUGIN_DIR"
    echo "helper=$CHORD_BIN"
  } >>"$STATE_DIR/chord.log"
  nohup python3 "$CHORD_BIN" >>"$STATE_DIR/chord.log" 2>&1 &
  local pid=$!
  echo "$pid" >"$CHORD_PID_FILE"
  for ((i=0; i<50; i++)); do
    if [[ -f $STATE_DIR/chord-ready ]] && kill -0 "$pid" 2>/dev/null; then return 0; fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
  done
  echo "Clean Lock keyboard monitor failed to start; inputs restored. See $STATE_DIR/chord.log" >&2
  return 1
}

guard_stop() {
  kill_pidfile "$GUARD_PID_FILE"
  return 0
}

guard_start() {
  guard_stop
  if [[ ! -f $GUARD_BIN ]]; then
    echo "cleanlock: missing guard helper at $GUARD_BIN" >>"$STATE_DIR/guard.log"
    echo "cleanlock: missing guard helper at $GUARD_BIN" >&2
    return 1
  fi
  nohup python3 "$GUARD_BIN" >>"$STATE_DIR/guard.log" 2>&1 &
  echo $! >"$GUARD_PID_FILE"
  return 0
}

diagnose() {
  echo "pluginDir=$PLUGIN_DIR"
  echo "chordBin=$CHORD_BIN ($( [[ -f $CHORD_BIN ]] && echo ok || echo MISSING ))"
  echo "guardBin=$GUARD_BIN ($( [[ -f $GUARD_BIN ]] && echo ok || echo MISSING ))"
  echo "scriptPath=$SCRIPT_PATH"
  echo "user=$(id -un) groups=$(id -Gn)"
  echo "inputDevicePerms:"
  ls -l /dev/input/event* 2>/dev/null | head -8 || echo "  (none)"
  echo "hyprlandKeyboards:"
  list_keyboards | sed 's/^/  /' || true
  echo "hyprlandTrackpads:"
  list_trackpads | sed 's/^/  /' || true
  echo "state=$(read_state)"
  echo "chordPid=$(cat "$CHORD_PID_FILE" 2>/dev/null || echo none)"
  echo "guardPid=$(cat "$GUARD_PID_FILE" 2>/dev/null || echo none)"
  echo "--- chord.log (tail) ---"
  tail -n 40 "$STATE_DIR/chord.log" 2>/dev/null || echo "(empty)"
  echo "--- guard.log (tail) ---"
  tail -n 20 "$STATE_DIR/guard.log" 2>/dev/null || echo "(empty)"
}
release_stay_awake_if_owned() {
  if [[ -f $STAY_AWAKE_OWNED ]]; then
    rm -f "$STAY_AWAKE_OWNED"
    omarchy-toggle-idle allow-idle >/dev/null 2>&1 || true
  fi
}

notify_locked() {
  local msg=$1
  if [[ $SILENT == 1 ]]; then
    return 0
  fi
  omarchy-osd -i keyboard -m "$msg — hold Super/Win 5s to unlock" 2>/dev/null || true
  notify-send -a CleanLock -i input-keyboard -u critical -t 0 \
    "$msg" \
    "Hold one Super / Windows key for 5 seconds to unlock. Sleep/lock are inhibited while cleaning." >/dev/null 2>&1 || true
}

notify_unlocked() {
  if [[ $SILENT == 1 ]]; then
    return 0
  fi
  local reason=${CLEANLOCK_UNLOCK_REASON:-}
  local body="Keyboard and trackpad are active again."
  case "$reason" in
    session-locked) body="Unlocked automatically so you can enter your password." ;;
    prepare-for-sleep) body="Unlocked automatically before sleep/hibernate." ;;
  esac
  omarchy-osd -i keyboard -m "Inputs unlocked" 2>/dev/null || true
  notify-send -a CleanLock -i input-keyboard "Unlocked" "$body" -t 4000 >/dev/null 2>&1 || true
}

lock_devices() {
  local want_kb=$1 want_tp=$2
  local -a kbs=() tps=()
  python3 "$CHORD_BIN" --check >/dev/null || return 1
  # Record intended devices before changing them, so errors can roll back.
  trap 'CLEANLOCK_SILENT=1 unlock_all; exit 1' ERR

  mapfile -t existing_kb < <(jq -r '.keyboard[]?' <<<"$(read_state)")
  mapfile -t existing_tp < <(jq -r '.trackpad[]?' <<<"$(read_state)")

  if ((want_kb)); then
    if ((${#existing_kb[@]})); then
      kbs=("${existing_kb[@]}")
    else
      mapfile -t kbs < <(list_keyboards)
    fi
    if ((${#kbs[@]} == 0)); then
      echo "No physical keyboard found" >&2
      exit 1
    fi

  else
    kbs=("${existing_kb[@]}")
  fi

  if ((want_tp)); then
    if ((${#existing_tp[@]})); then
      tps=("${existing_tp[@]}")
    else
      mapfile -t tps < <(list_trackpads)
    fi
    if ((${#tps[@]} == 0)); then
      echo "No trackpad found" >&2
      exit 1
    fi
  else
    tps=("${existing_tp[@]}")
  fi

  local kb_json tp_json
  kb_json=$(printf '%s\n' "${kbs[@]}" | jq -R . | jq -s -c 'map(select(length>0))')
  tp_json=$(printf '%s\n' "${tps[@]}" | jq -R . | jq -s -c 'map(select(length>0))')
  write_state "$kb_json" "$tp_json"
  chord_start
  for name in "${kbs[@]}" "${tps[@]}"; do
    [[ -n $name ]] || continue
    set_enabled "$name" false
  done
  guard_start
  trap - ERR

  local msg=
  if ((want_kb && want_tp)); then msg="Keyboard + trackpad locked"
  elif ((want_kb)); then msg="Keyboard locked"
  else msg="Trackpad locked"
  fi
  notify_locked "$msg"
}

unlock_all() {
  if [[ ${CLEANLOCK_FROM_CHORD:-0} != 1 ]]; then
    chord_stop
  else
    rm -f "$CHORD_PID_FILE" "$PROGRESS_FILE" "$STATE_DIR/chord-ready"
  fi
  # When unlock is requested by cleanlock-guard itself, do not kill the guard
  # mid-flight — it will exit after unlock returns.
  if [[ ${CLEANLOCK_FROM_GUARD:-0} != 1 ]]; then
    guard_stop
  fi
  local state failed=0
  state=$(read_state)
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    set_enabled "$name" true || failed=1
  done < <(jq -r '.keyboard[]?, .trackpad[]?' <<<"$state")
  if ((failed)); then
    echo "Could not restore every input device; run cleanlock unlock again." >&2
    return 1
  fi
  rm -f "$STATE_FILE"
  release_stay_awake_if_owned
  notify_unlocked
}

status_json() {
  local state kb_n tp_n
  state=$(read_state)
  kb_n=$(jq '.keyboard | length' <<<"$state")
  tp_n=$(jq '.trackpad | length' <<<"$state")
  local progress=0
  [[ -f $PROGRESS_FILE ]] && progress=$(cat "$PROGRESS_FILE" 2>/dev/null || echo 0)
  local inhibiting=false
  [[ -f $GUARD_PID_FILE ]] && kill -0 "$(cat "$GUARD_PID_FILE" 2>/dev/null)" 2>/dev/null && inhibiting=true
  jq -nc --argjson state "$state" --argjson progress "${progress:-0}" \
    --argjson keyboardLocked "$kb_n" --argjson trackpadLocked "$tp_n" \
    --argjson inhibiting "$inhibiting" '
    {
      keyboard: $state.keyboard,
      trackpad: $state.trackpad,
      keyboardLocked: ($keyboardLocked > 0),
      trackpadLocked: ($trackpadLocked > 0),
      locked: (($keyboardLocked > 0) or ($trackpadLocked > 0)),
      chordProgress: ($progress|tonumber),
      inhibitingSleep: $inhibiting
    }'
}

cmd=${1:-}
case "$cmd" in
  lock-keyboard) lock_devices 1 0 ;;
  lock-trackpad) lock_devices 0 1 ;;
  lock-both) lock_devices 1 1 ;;
  unlock) unlock_all ;;
  status) status_json ;;
  setup-input) exec "$PLUGIN_DIR/bin/cleanlock-setup-input" ;;
  diagnose) diagnose ;;
  chord-start) chord_start ;;
  chord-stop) chord_stop ;;
  guard-start) guard_start ;;
  guard-stop) guard_stop ;;
  *) usage; exit 1 ;;
esac
